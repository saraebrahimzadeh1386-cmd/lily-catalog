  <script>
    let currentPage = 1;
    const totalPages = 18;
    let currentScale = 0.55;

    const pageTitles = {
      1: "کاور اصلی برند",
      2: "درباره‌ی عطر لیلی",
      3: "راهنمای کاتالوگ و ترموستات",
      4: "فهرست بخش‌های کاتالوگ",
      5: "انتخاب سریع (کدوم عطر مال توئه؟)",
      6: "نقشه‌ی ترموستات رایحه‌ها",
      7: "ترند و پرفروش‌ها - بخش اول",
      8: "ترند و پرفروش‌ها - بخش دوم",
      9: "خاص و نیش (یونیسکس)",
      10: "عطرهای فصلی: پاییز 🍂",
      11: "عطرهای فصلی: زمستان ❄️",
      12: "کالکشن اختصاصی زنانه",
      13: "کالکشن اختصاصی مردانه",
      14: "طیف طبع‌های گرم (۴ و ۵)",
      15: "طیف طبع‌های خنک (۱ و ۲)",
      16: "فهرست برندها",
      17: "کارت کامل برند دیور Dior",
      18: "کارت کامل برند شنل Chanel"
    };

    const stage = document.getElementById('catalog-stage');
    const zoomText = document.getElementById('zoom-percent');
    const pageSelect = document.getElementById('page-select');
    const dotsContainer = document.getElementById('dots-container');

    // پر کردن سلکتور و دکمه‌های ناوبری
    function setupNavigation() {
      pageSelect.innerHTML = '';
      dotsContainer.innerHTML = '';

      for (let i = 1; i <= totalPages; i++) {
        // سلکتور
        const opt = document.createElement('option');
        opt.value = i;
        opt.textContent = `${i}. ${pageTitles[i]}`;
        pageSelect.appendChild(opt);

        // دکمه‌های پایین
        const btn = document.createElement('button');
        btn.id = `dot-${i}`;
        btn.className = "px-2.5 py-1 rounded-md text-[11px] whitespace-nowrap transition text-[#C5CBD3] hover:text-white";
        btn.textContent = `${i}`;
        btn.onclick = () => goToPage(i);
        dotsContainer.appendChild(btn);
      }
    }

    function autoFitScale() {
      // فضای بیشتر برای کاتالوگ بزرگ‌تر و مرکزی (کمتر از هدر و فوتر کم می‌کنیم)
      const availableHeight = window.innerHeight - 130;
      const availableWidth = window.innerWidth - 40;
      const scaleY = availableHeight / 1350;
      const scaleX = availableWidth / 1080;
      let optimalScale = Math.min(scaleX, scaleY);
      // اجازه می‌دهیم کمی بزرگ‌تر شود روی موبایل
      optimalScale = Math.min(Math.max(optimalScale, 0.28), 0.98);
      currentScale = optimalScale;
      applyScale();
    }

    function applyScale() {
      stage.style.transform = `scale(${currentScale})`;
      zoomText.textContent = `${Math.round(currentScale * 100)}%`;
      // مرکز کردن بهتر
      stage.parentElement.style.height = `${1350 * currentScale + 16}px`;
      stage.parentElement.style.width = `${1080 * currentScale + 16}px`;
    }

    function adjustZoom(delta) {
      currentScale = Math.min(Math.max(currentScale + delta, 0.25), 1.2);
      applyScale();
    }

    function resetZoom() {
      autoFitScale();
    }

    function goToPage(page) {
      if (page < 1 || page > totalPages) return;
      currentPage = page;

      for (let i = 1; i <= totalPages; i++) {
        const p = document.getElementById(`page-${i}`);
        const dot = document.getElementById(`dot-${i}`);
        if (p) p.classList.add('hidden');
        if (dot) {
          dot.className = "px-2.5 py-1 rounded-md text-[11px] whitespace-nowrap transition text-[#C5CBD3] hover:text-white";
        }
      }

      const activePage = document.getElementById(`page-${page}`);
      if (activePage) activePage.classList.remove('hidden');

      const activeDot = document.getElementById(`dot-${page}`);
      if (activeDot) {
        activeDot.className = "px-2.5 py-1 rounded-md text-[11px] whitespace-nowrap transition bg-[#F6F0E6] text-[#0B1F3A] font-bold";
      }

      pageSelect.value = page;
    }

    function nextPage() {
      if (currentPage < totalPages) goToPage(currentPage + 1);
      else goToPage(1);
    }

    function prevPage() {
      if (currentPage > 1) goToPage(currentPage - 1);
      else goToPage(totalPages);
    }

    window.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') nextPage();
      if (e.key === 'ArrowRight') prevPage();
    });

    window.addEventListener('resize', autoFitScale);
    window.addEventListener('load', () => {
      setupNavigation();
      autoFitScale();
      goToPage(1);
    });
  </script>

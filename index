<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>کاتالوگ دیجیتال عطر لیلی | Lily perfume</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@200;300;400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    * {
      box-sizing: border-box;
      -webkit-font-smoothing: antialiased;
    }
    body {
      font-family: 'Vazirmatn', sans-serif;
      user-select: none;
      background-color: #060E18;
      color: #F6F0E6;
    }
    .catalog-canvas {
      width: 1080px;
      height: 1350px;
      flex-shrink: 0;
      position: relative;
      overflow: hidden;
      padding: 90px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(197, 203, 211, 0.15);
      border-radius: 28px;
    }
    .silver-gradient-text {
      background: linear-gradient(135deg, #FFFFFF 0%, #C5CBD3 50%, #8E98A5 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .luxury-line {
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(197, 203, 211, 0.4), transparent);
    }
    .thermo-mini-track {
      width: 100%;
      height: 6px;
      border-radius: 3px;
      background: linear-gradient(90deg, #8FB3D9 0%, #C5CBD3 50%, #D9A066 100%);
      position: relative;
    }
    .thermo-mini-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      position: absolute;
      top: -3px;
      background: #FFFFFF;
      box-shadow: 0 0 8px rgba(0,0,0,0.4);
      transform: translateX(50%);
    }
    .editorial-img {
      object-fit: cover;
      border-radius: 18px;
      box-shadow: 0 15px 35px -5px rgba(0,0,0,0.3);
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between overflow-x-hidden">

  <!-- ==================== نوار ابزار کنترل بالا ==================== -->
  <header class="bg-[#0B1F3A]/95 backdrop-blur-md border-b border-[#C5CBD3]/20 py-3 px-4 sticky top-0 z-50">
    <div class="max-w-5xl mx-auto flex flex-col items-center gap-2.5">
      <!-- عنوان برند - مرکز -->
      <div class="flex flex-col items-center text-center">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-full border border-[#C5CBD3]/40 flex items-center justify-center bg-white/5">
            <svg class="w-3.5 h-3.5 stroke-[#C5CBD3]" fill="none" viewBox="0 0 100 100">
              <path d="M50 15 C45 38 28 46 15 50 C28 54 45 62 50 85 C55 62 72 54 85 50 C72 46 55 38 50 15 Z" stroke-width="2.5"/>
            </svg>
          </div>
          <span class="text-base font-bold tracking-wide text-white">عطر لیلی</span>
        </div>
        <span class="text-[11px] text-[#C5CBD3]/80 font-light tracking-wide mt-0.5">کاتالوگ هوشمند ۱۸ صفحه</span>
      </div>

      <!-- کنترل‌های شیشه‌ای - مرکز -->
      <div class="flex items-center gap-3 flex-wrap justify-center">
        <div class="flex items-center gap-2 bg-white/5 px-3 py-1.5 rounded-full border border-[#C5CBD3]/25 text-xs backdrop-blur-sm">
          <span class="text-[#C5CBD3]">صفحه:</span>
          <select id="page-select" onchange="goToPage(parseInt(this.value))" class="bg-transparent text-white font-medium outline-none cursor-pointer max-w-[180px]">
            <!-- داینامیک از جاوااسکریپت پر می‌شود -->
          </select>
        </div>

        <div class="flex items-center gap-1.5 bg-white/5 px-2.5 py-1.5 rounded-full border border-[#C5CBD3]/25 backdrop-blur-sm">
          <button onclick="adjustZoom(-0.05)" class="w-7 h-7 rounded-lg bg-white/5 border border-[#C5CBD3]/20 hover:bg-white/15 text-white flex items-center justify-center text-xs">−</button>
          <span id="zoom-percent" class="text-xs font-mono w-9 text-center text-[#C5CBD3]">55%</span>
          <button onclick="adjustZoom(0.05)" class="w-7 h-7 rounded-lg bg-white/5 border border-[#C5CBD3]/20 hover:bg-white/15 text-white flex items-center justify-center text-xs">+</button>
          <button onclick="resetZoom()" class="text-[11px] px-2.5 py-1 rounded-lg bg-white/10 hover:bg-white/20 text-[#C5CBD3] mr-1">اندازه خودکار</button>
        </div>
      </div>
    </div>
  </header>

  <!-- ==================== شبیه‌ساز ابعاد اصلی کاتالوگ ==================== -->
  <main class="flex-1 flex items-center justify-center px-2 py-3 relative overflow-hidden">

    <!-- دکمه صفحه بعد (در RTL سمت راست = جلو) -->
    <button onclick="nextPage()" class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 z-40 w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-[#0B1F3A]/90 hover:bg-[#0B1F3A] border border-[#C5CBD3]/40 text-white flex items-center justify-center shadow-2xl backdrop-blur-md transition group">
      <svg class="w-5 h-5 group-hover:scale-110 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </button>

    <!-- دکمه صفحه قبل (در RTL سمت چپ = عقب) -->
    <button onclick="prevPage()" class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 z-40 w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-[#0B1F3A]/90 hover:bg-[#0B1F3A] border border-[#C5CBD3]/40 text-white flex items-center justify-center shadow-2xl backdrop-blur-md transition group">
      <svg class="w-5 h-5 group-hover:scale-110 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </button>

    <!-- فضای رندر کاتالوگ -->
    <div id="catalog-stage" class="transition-transform duration-200 origin-center">

      <!-- ================= صفحه ۱: کاور ================= -->
      <div id="page-1" class="catalog-canvas bg-[#0B1F3A] text-[#F6F0E6] relative">
        <!-- تصویر استودیویی پس‌زمینه گل لیلیوم با پوشش گرادیان سرمه‌ای -->
        <img src="Gemini_Generated_Image_yq3enbyq3enbyq3e.jpg" alt="Lily flower" class="absolute inset-0 w-full h-full object-cover opacity-20 pointer-events-none mix-blend-luminosity">
        
        <div class="relative z-10 flex items-center justify-between">
          <span class="text-[26px] font-light tracking-[6px] text-[#C5CBD3]/80 uppercase">LUXURY PERFUME COLLECTION</span>
          <div class="w-12 h-12 rounded-full border border-[#C5CBD3]/30 flex items-center justify-center bg-white/5">
            <svg class="w-6 h-6 stroke-[#C5CBD3]" fill="none" viewBox="0 0 100 100"><path d="M50 15 C45 38 28 46 15 50 C28 54 45 62 50 85 C55 62 72 54 85 50 C72 46 55 38 50 15 Z" stroke-width="2"/></svg>
          </div>
        </div>

        <div class="relative z-10 my-auto text-center flex flex-col items-center">
          <div class="w-20 h-20 rounded-full border border-[#C5CBD3]/30 flex items-center justify-center mb-6 bg-white/[0.04]">
            <svg class="w-11 h-11 stroke-[#C5CBD3]" fill="none" viewBox="0 0 100 100">
              <path d="M50 15 C45 38 28 46 15 50 C28 54 45 62 50 85 C55 62 72 54 85 50 C72 46 55 38 50 15 Z" stroke-width="1.8"/>
              <circle cx="50" cy="50" r="3" fill="#C5CBD3"/>
            </svg>
          </div>
          <h1 class="text-[94px] font-light leading-none mb-3 silver-gradient-text tracking-tight">عطر لیلی</h1>
          <div class="text-[36px] font-extralight text-[#C5CBD3] tracking-[16px] uppercase mb-8 pl-4">Lily perfume</div>
          <div class="w-32 luxury-line mb-8"></div>
          <p class="text-[34px] font-light text-[#F6F0E6] max-w-[760px] leading-relaxed" dir="rtl">
            «دوستم؛ تنوع لیلی، دست خالی برت نمی‌گردونه (:»
          </p>
        </div>

        <div class="relative z-10 flex flex-col gap-6">
          <div class="grid grid-cols-3 gap-6 text-center">
            <div class="py-4 border border-[#C5CBD3]/25 rounded-2xl bg-black/25 backdrop-blur-sm">
              <span class="text-[28px] font-medium text-[#F6F0E6]">۱۰۰٪ اورجینال</span>
            </div>
            <div class="py-4 border border-[#C5CBD3]/25 rounded-2xl bg-black/25 backdrop-blur-sm">
              <span class="text-[28px] font-medium text-[#F6F0E6]">تضمینی</span>
            </div>
            <div class="py-4 border border-[#C5CBD3]/25 rounded-2xl bg-black/25 backdrop-blur-sm">
              <span class="text-[28px] font-medium text-[#F6F0E6]">خوش‌قیمت</span>
            </div>
          </div>
          <div class="flex items-center justify-between pt-4 border-t border-[#C5CBD3]/20 text-[24px] text-[#C5CBD3]/70">
            <span>صفحه ۰۱</span>
            <span>ورق بزنید</span>
          </div>
        </div>
      </div>

      <!-- ================= صفحه ۲: درباره لیلی با موکاپ پداستال ۴ بطری ================= -->
      <div id="page-2" class="catalog-canvas bg-[#F6F0E6] text-[#0B1F3A] hidden">
        <div class="flex items-center justify-between border-b border-[#0B1F3A]/10 pb-4">
          <div>
            <span class="text-[24px] tracking-widest text-[#0B1F3A]/60 font-semibold uppercase block mb-1">اصالت بدون واسطه</span>
            <h2 class="text-[56px] font-light text-[#0B1F3A]">درباره‌ی عطر لیلی</h2>
          </div>
          <span class="text-[24px] text-[#0B1F3A]/50 font-mono">ABOUT LILY</span>
        </div>

        <div class="my-auto grid grid-cols-12 gap-8 items-center">
          <!-- تصویر موکاپ پداستال لوکس -->
          <div class="col-span-5 relative">
            <div class="p-2 bg-white rounded-2xl border border-[#0B1F3A]/10 shadow-lg">
              <img src="Gemini_Generated_Image_d5rajod5rajod5ra_pedestal.jpg" alt="Lily Perfume Bottles on Pedestal" class="editorial-img w-full h-[540px] object-cover">
            </div>
            <span class="block text-center text-[20px] text-[#0B1F3A]/50 mt-2 font-light">طراحی شیک و شیشه‌های اختصاصی لیلی</span>
          </div>

          <!-- توضیحات و ستون‌های ارزش -->
          <div class="col-span-7 flex flex-col gap-5">
            <p class="text-[30px] font-light text-[#2C3E50] leading-[1.8] text-justify">
              ما واردکننده‌ی مستقیم کالکشن‌های کامل معتبرترین برندهای جهان هستیم؛ تنوعی گسترده از شاهکارهای محبوب تا عطرهای دست‌ساز نیش. در لیلی، انتخاب عطر تجربه‌ای ساده، مطمئن و دلنشین است.
            </p>
            <div class="space-y-4">
              <div class="p-4 rounded-xl border border-[#0B1F3A]/15 bg-white/80">
                <span class="text-[30px] font-bold text-[#0B1F3A] block mb-1">۱۰۰٪ اورجینال</span>
                <span class="text-[26px] font-light text-[#4A5568]">اصالت تک‌تک بطری‌ها مستقیماً تضمین شده است.</span>
              </div>
              <div class="p-4 rounded-xl border border-[#0B1F3A]/15 bg-white/80">
                <span class="text-[30px] font-bold text-[#0B1F3A] block mb-1">تضمینی</span>
                <span class="text-[26px] font-light text-[#4A5568]">کالکشن کامل زنانه و مردانه با بالاترین کیفیت عرضه.</span>
              </div>
              <div class="p-4 rounded-xl border border-[#0B1F3A]/15 bg-white/80">
                <span class="text-[30px] font-bold text-[#0B1F3A] block mb-1">خوش‌قیمت</span>
                <span class="text-[26px] font-light text-[#4A5568]">بهترین قیمت ممکن بازار به دلیل واردات مستقیم و بی‌واسطه.</span>
              </div>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-[#0B1F3A]/15">
          <span class="text-[26px] font-medium text-[#0B1F3A]/60">صفحه ۰۲</span>
          <button onclick="goToPage(4)" class="px-6 py-2.5 rounded-full border border-[#0B1F3A]/30 text-[24px] font-medium hover:bg-[#0B1F3A] hover:text-[#F6F0E6] transition">فهرست بخش‌ها</button>
        </div>
      </div>

      <!-- ================= صفحه ۳: راهنمای کاتالوگ با موکاپ مرمر ================= -->
      <div id="page-3" class="catalog-canvas bg-[#0B1F3A] text-[#F6F0E6] hidden">
        <div class="flex items-center justify-between border-b border-[#C5CBD3]/15 pb-4">
          <div>
            <span class="text-[24px] tracking-widest text-[#C5CBD3]/70 font-semibold uppercase block mb-1">راهنمای هوشمند</span>
            <h2 class="text-[56px] font-light text-white">زبان بصری رایحه‌ها</h2>
          </div>
          <span class="text-[24px] text-[#C5CBD3]/50 font-mono">SCENT GUIDE</span>
        </div>

        <div class="my-auto grid grid-cols-12 gap-8 items-center">
          <div class="col-span-8 flex flex-col gap-5">
            <div class="p-5 rounded-2xl border border-[#C5CBD3]/20 bg-white/[0.03]">
              <span class="text-[30px] font-medium text-white mb-2 block">۱. ترموستات رایحه (طبع حرارتی)</span>
              <div class="thermo-mini-track my-3">
                <div class="thermo-mini-dot" style="left: 30%;"></div>
              </div>
              <div class="flex justify-between text-[24px] text-[#C5CBD3]/80">
                <span class="text-[#8FB3D9]">۱ خیلی خنک</span>
                <span>۲ خنک</span>
                <span>۳ متعادل</span>
                <span class="text-[#D9A066]">۴ گرم</span>
                <span class="text-[#D9A066]">۵ خیلی گرم</span>
              </div>
            </div>

            <div class="p-5 rounded-2xl border border-[#C5CBD3]/20 bg-white/[0.03] flex items-center justify-between">
              <div>
                <span class="text-[28px] font-medium text-white block mb-2">۲. سطح کالکشن</span>
                <div class="flex gap-2 text-[24px] text-[#C5CBD3]">
                  <span class="px-2.5 py-0.5 rounded border border-[#C5CBD3]/30">کلاسیک</span>
                  <span class="px-2.5 py-0.5 rounded border border-[#C5CBD3]/30">پرستیژ</span>
                  <span class="px-2.5 py-0.5 rounded border border-[#C5CBD3]/30">نیش</span>
                </div>
              </div>
              <div class="h-10 w-[1px] bg-[#C5CBD3]/20"></div>
              <div>
                <span class="text-[28px] font-medium text-white block mb-2">۳. فصل و جنسیت</span>
                <div class="flex gap-2 text-[24px] text-[#C5CBD3]">
                  <span>🍂 پاییز</span>
                  <span>❄️ زمستان</span>
                  <span>زنانه / مردانه</span>
                </div>
              </div>
            </div>

            <div class="p-5 rounded-2xl border border-[#C5CBD3]/30 bg-white/[0.05] flex items-center justify-between">
              <div>
                <span class="text-[28px] font-bold text-white block">۴. سفارش با «کد اختصاصی»</span>
                <p class="text-[24px] text-[#C5CBD3]/80 mt-1">کافیست فقط کد درج‌شده روی کارت را در دایرکت ارسال کنید.</p>
              </div>
              <div class="px-5 py-2 rounded-xl border border-[#C5CBD3]/40 bg-[#060E18] text-[26px] font-mono text-[#F6F0E6]">W-DIOR-01</div>
            </div>
          </div>

          <!-- تصویر موکاپ مرمر ادیتوریال -->
          <div class="col-span-4 relative">
            <div class="p-2 bg-white/10 rounded-2xl border border-[#C5CBD3]/20 backdrop-blur-sm">
              <img src="Gemini_Generated_Image_d5rajod5rajod5ra.jpg" alt="Lily Perfume on Marble" class="editorial-img w-full h-[520px] object-cover">
            </div>
            <span class="block text-center text-[18px] text-[#C5CBD3]/60 mt-2 font-light">طراحی مینیمال شیشه‌ها با گلبرگ لیلیوم</span>
          </div>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-[#C5CBD3]/15">
          <span class="text-[26px] font-medium text-[#C5CBD3]/60">صفحه ۰۳</span>
          <button onclick="goToPage(4)" class="px-6 py-2.5 rounded-full border border-[#C5CBD3]/30 text-[24px] font-medium hover:bg-white/10 transition">فهرست بخش‌ها</button>
        </div>
      </div>
      <!-- ================= صفحه ۶: نقشه‌ی ترموستات با شات واقعی محصول ================= -->
      <div id="page-6" class="catalog-canvas bg-[#F6F0E6] text-[#0B1F3A] hidden">
        <div>
          <span class="text-[26px] tracking-widest text-[#0B1F3A]/60 font-semibold uppercase block mb-1">پیوستار حرارتی کاتالوگ</span>
          <h2 class="text-[56px] font-light text-[#0B1F3A]">نقشه‌ی ترموستات رایحه‌ها</h2>
        </div>

        <div class="my-auto flex flex-col gap-6">
          <div class="w-full h-7 rounded-full relative" style="background: linear-gradient(90deg, #8FB3D9 0%, #C5CBD3 50%, #D9A066 100%);"></div>
          
          <div class="grid grid-cols-5 gap-3 text-center">
            <div class="flex flex-col gap-1.5 p-3 bg-white/80 border border-[#8FB3D9]/40 rounded-xl">
              <span class="text-[26px] font-bold text-[#8FB3D9]">۱. خیلی خنک</span>
              <span class="text-[22px] font-light text-[#4A5568]">لایت بلو DG</span>
              <span class="text-[22px] font-light text-[#4A5568]">آکوا دی جیو</span>
              <span class="text-[22px] font-light text-[#4A5568]">نرولی TF</span>
            </div>

            <div class="flex flex-col gap-1.5 p-3 bg-white/80 border border-[#C5CBD3] rounded-xl">
              <span class="text-[26px] font-bold text-[#2C3E50]">۲. خنک</span>
              <span class="text-[22px] font-light text-[#4A5568]">ساواژ Dior</span>
              <span class="text-[22px] font-light text-[#4A5568]">بلو دو شنل</span>
              <span class="text-[22px] font-light text-[#4A5568]">ایمجینیشن LV</span>
            </div>

            <div class="flex flex-col gap-1.5 p-3 bg-white/80 border border-[#C5CBD3] rounded-xl">
              <span class="text-[26px] font-bold text-[#0B1F3A]">۳. متعادل</span>
              <span class="text-[22px] font-light text-[#4A5568]">میس دیور</span>
              <span class="text-[22px] font-light text-[#4A5568]">ژادور Dior</span>
              <span class="text-[22px] font-light text-[#4A5568]">لیبر YSL</span>
            </div>

            <div class="flex flex-col gap-1.5 p-3 bg-white/80 border border-[#D9A066]/40 rounded-xl">
              <span class="text-[26px] font-bold text-[#D9A066]">۴. گرم</span>
              <span class="text-[22px] font-light text-[#4A5568]">دیور هوم</span>
              <span class="text-[22px] font-light text-[#4A5568]">کوکو مادمازل</span>
              <span class="text-[22px] font-light text-[#4A5568]">باکارات ۵۴۰</span>
            </div>

            <div class="flex flex-col gap-1.5 p-3 bg-white/80 border border-[#D9A066] rounded-xl">
              <span class="text-[26px] font-bold text-[#D9A066]">۵. خیلی گرم</span>
              <span class="text-[22px] font-light text-[#4A5568]">وانیلا ۲۸ KYL</span>
              <span class="text-[22px] font-light text-[#4A5568]">پرایوت بلند TF</span>
              <span class="text-[22px] font-light text-[#4A5568]">آنجلز شیر</span>
            </div>
          </div>

          <!-- بخش شات محصول واقعی برای اعتمادسازی ۱۰۰٪ -->
          <div class="mt-2 p-5 rounded-2xl bg-white border border-[#0B1F3A]/10 shadow-sm flex items-center gap-6">
            <img src="Gemini_Generated_Image_8c3j1v8c3j1v8c3j.jpg" alt="Real Lily Perfume Bottle" class="w-36 h-36 object-cover rounded-xl border border-[#0B1F3A]/10">
            <div>
              <span class="text-[24px] font-bold text-[#0B1F3A] block">عکاسی از نمونه واقعی ارسالی لیلی</span>
              <p class="text-[22px] font-light text-[#4A5568] leading-relaxed mt-1">
                تمام سفارش‌ها در شیشه‌های شفاف باکیفیت بالا، والو اتومایزر طلایی و لیبل اختصاصی عطر لیلی همراه با بارکد و شناسه اصالت تقدیم شما می‌شود.
              </p>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-[#0B1F3A]/20">
          <span class="text-[26px] font-medium text-[#0B1F3A]/60">صفحه ۰۶</span>
          <button onclick="goToPage(4)" class="px-6 py-2.5 rounded-full border border-[#0B1F3A]/30 text-[26px] font-medium hover:bg-[#0B1F3A] hover:text-[#F6F0E6] transition">فهرست بخش‌ها</button>
